# Clave de API de Google Gemini (opcional pero recomendada para inferencia en tiempo real en "Ask My CV" y sync del CV)
# Si no se proporciona o se agota la cuota, el sistema activa automáticamente el motor semántico de respaldo local
# sin que el usuario ni el reclutador experimenten ningún error.
GEMINI_API_KEY=tu_api_key_aqui
