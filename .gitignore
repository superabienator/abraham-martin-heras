# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cv-inbox privacy rules (ignore private certificates, checkpoints & backups; keep automation scripts)
/cv-inbox/*
!/cv-inbox/sync-cv.mjs
!/cv-inbox/actualizar-cv.sh
!/cv-inbox/README-INBOX.md
src/data/cv-data.backup.ts
*.backup.ts
